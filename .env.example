# ============================================================================
# [토스 미니앱 유료화 팩토리] 사용자 동적 주입 환경변수 템플릿 (.env.example)
# ----------------------------------------------------------------------------
# 배포 직전 사용자(앱 소유자)가 아래 공란에 본인의 식별 정보와 판매 금액을 직접 기입합니다.
# 본 파일(.env.example)은 템플릿이므로 값을 비워둡니다. 실제 구동 시에는 .env 파일에 기입하세요.
# ============================================================================

# 1. 앱 소유자(판매자) 개인 식별 정보 (정산 및 파트너 콘솔 표시용)
APP_OWNER_ID=
USER_IDENTITY=

# 2. 토스 미니앱 유료 리포트 1회 결제가 (단위: 원, 예: 1900, 2900, 3900)
MONETIZATION_PRICE=
REVENUE_PRICE=

# 3. 정산 계좌 또는 토스 파트너 정산 코드 (AES-256 암호화 보관 대상)
OWNER_SETTLEMENT_ACCOUNT=

# 4. 개인정보(생년월일, 이름 등) DB 저장 전 AES-256-GCM 암호화를 위한 비밀키 (32자 이상 권장)
ENCRYPTION_SECRET_KEY=

# 5. 서버 구동 포트 (기본값: 3000)
PORT=
