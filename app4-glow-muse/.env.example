# ============================================================================
# [뮤즈글로우 AI v4.0 - App Business Evaluator Override 반영 동적 환경변수 템플릿]
# 본 파일(.env.example)은 플레이스홀더 규격이므로 값을 비워둡니다.
# 배포 직전 사용자가 .env 파일에 정산자 정보, 고LTV 가격 정책, 크레딧 한도를 직접 주입합니다.
# ============================================================================

# 1. 앱 소유자 및 정산 식별 정보 (배포 직전 사용자가 직접 입력)
APP_OWNER_ID=
USER_IDENTITY=
SETTLEMENT_ACCOUNT_HOLDER=

# 2. [App Business Evaluator Override] 동적 유료화 금액 및 장기 체험 설정
# - VIP_ANNUAL_PRICE: 진성 유저 필터링 및 RLTV 6배 극대화용 연간 VIP 패스 금액 (예: 79000, 약 $60~$62.19)
# - MONETIZATION_PRICE / REVENUE_PRICE: 보조(Decoy) 스타터 크레딧 팩 금액 (예: 9900)
# - TRIAL_DAYS: 전환율 42.5%를 달성하는 17~32일 장기 무료 체험 일수 (예: 21)
VIP_ANNUAL_PRICE=
MONETIZATION_PRICE=
REVENUE_PRICE=
TRIAL_DAYS=

# 3. [Thin Wrapper 파산 방어] AI 추론 크레딧 한도(Credit Cap) 설정
VIP_CREDIT_CAP=
STARTER_CREDIT_CAP=

# 4. 민감 개인정보 및 파우치 자산 보호용 AES-256-GCM 마스터 암호화 키 (64자리 Hex 문자열)
ENCRYPTION_MASTER_KEY=

# 5. 토스 미니앱 파트너 콘솔 연동용 가상 식별자 및 포트 설정 (App #4 기본 포트: 3003)
TOSS_MINIAPP_ID=
PORT=

# ============================================================================
# 6. [실제 AI 모델 연동] LLM / Vision 게이트웨이 설정
# ----------------------------------------------------------------------------
# - AI_PROVIDER: auto | gemini | openai | anthropic | none
#     auto → 아래 키 중 주입된 첫 번째 제공자를 자동 선택
#     none  → 강제로 로컬 결정론적 엔진(목업) 사용 (QA/데모용)
# - 키가 하나도 없으면 서버는 자동으로 기존 목업 엔진으로 폴백합니다(서비스 중단 없음).
# ============================================================================
AI_PROVIDER=
GEMINI_API_KEY=
GEMINI_MODEL=
OPENAI_API_KEY=
OPENAI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# (선택) 사내 프록시·로컬 목 서버 사용 시에만 오버라이드
GEMINI_BASE_URL=
OPENAI_BASE_URL=
ANTHROPIC_BASE_URL=

# (선택) AI 호출 튜닝 (기본값: 타임아웃 20초 / 최대 2048 토큰 / 온도 0.7)
AI_TIMEOUT_MS=
AI_MAX_TOKENS=
AI_TEMPERATURE=

# ============================================================================
# 7. [토스페이먼츠 실결제 연동] 결제 게이트웨이 설정
# ----------------------------------------------------------------------------
# - 클라이언트 키(브라우저 노출 O)와 시크릿 키(서버 전용, 절대 노출 금지)를 모두 주입하면
#   TOSS_LIVE 실결제 모드로 동작하고, 없으면 기존 샌드박스 시뮬레이션으로 폴백합니다.
# - PUBLIC_BASE_URL 은 결제 성공/실패 리다이렉트 URL 생성에 사용됩니다.
#   (로컬: http://localhost:3003 / 배포: https://실제-도메인)
# ============================================================================
TOSS_PAYMENTS_CLIENT_KEY=
TOSS_PAYMENTS_SECRET_KEY=
PUBLIC_BASE_URL=

# ============================================================================
# 8. [Supabase 영속화] 세션·주문·매출 원장 DB 영구 보관 설정
# ----------------------------------------------------------------------------
# - 두 값을 모두 주입하면 Supabase(PostgREST)로 원장이 영구 저장됩니다.
# - 없으면 인메모리 모드로 동작하며(서비스는 정상), 서버 재시작 시 데이터가 소실됩니다.
# - SUPABASE_PERSISTENCE: auto | on | off  (off 로 두면 강제로 인메모리 모드)
# - ⚠️ SERVICE_ROLE_KEY 는 RLS 를 우회하는 서버 전용 키입니다. 절대 클라이언트 노출 금지.
# - 적용 순서: supabase/migrations/006_create_runtime_persistence_tables.sql 실행 후 재시작
# ============================================================================
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PERSISTENCE=
SUPABASE_TIMEOUT_MS=
