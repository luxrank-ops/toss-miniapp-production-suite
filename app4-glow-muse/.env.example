# ============================================================================
# [뮤즈글로우 AI v4.0 - App Business Evaluator Override 반영 동적 환경변수 템플릿]
# 본 파일(.env.example)은 플레이스홀더 규격이므로 값을 비워둡니다.
# 배포 직전 사용자가 .env 파일에 정산자 정보, 고LTV 가격 정책, 크레딧 한도를 직접 주입합니다.
# ============================================================================

# 1. 앱 소유자 및 정산 식별 정보 (배포 직전 사용자가 직접 입력)
APP_OWNER_ID=
USER_IDENTITY=
SETTLEMENT_ACCOUNT_HOLDER=

# 2. [App Business Evaluator Override] 동적 유료화 금액 및 장기 체험 설정
# - VIP_ANNUAL_PRICE: 진성 유저 필터링 및 RLTV 6배 극대화용 연간 VIP 패스 금액 (예: 79000, 약 $60~$62.19)
# - MONETIZATION_PRICE / REVENUE_PRICE: 보조(Decoy) 스타터 크레딧 팩 금액 (예: 9900)
# - TRIAL_DAYS: 전환율 42.5%를 달성하는 17~32일 장기 무료 체험 일수 (예: 21)
VIP_ANNUAL_PRICE=
MONETIZATION_PRICE=
REVENUE_PRICE=
TRIAL_DAYS=

# 3. [Thin Wrapper 파산 방어] AI 추론 크레딧 한도(Credit Cap) 설정
VIP_CREDIT_CAP=
STARTER_CREDIT_CAP=

# 4. 민감 개인정보 및 파우치 자산 보호용 AES-256-GCM 마스터 암호화 키 (64자리 Hex 문자열)
ENCRYPTION_MASTER_KEY=

# 5. 토스 미니앱 파트너 콘솔 연동용 가상 식별자 및 포트 설정 (App #4 기본 포트: 3003)
TOSS_MINIAPP_ID=
PORT=

# ============================================================================
# 6. [실제 AI 모델 연동] LLM / Vision 게이트웨이 설정
# ----------------------------------------------------------------------------
# - AI_PROVIDER: auto | gemini | openai | anthropic | none
#     auto → 아래 키 중 주입된 첫 번째 제공자를 자동 선택
#     none  → 강제로 로컬 결정론적 엔진(목업) 사용 (QA/데모용)
# - 키가 하나도 없으면 서버는 자동으로 기존 목업 엔진으로 폴백합니다(서비스 중단 없음).
# ============================================================================
AI_PROVIDER=
GEMINI_API_KEY=
GEMINI_MODEL=
OPENAI_API_KEY=
OPENAI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# (선택) 사내 프록시·로컬 목 서버 사용 시에만 오버라이드
GEMINI_BASE_URL=
OPENAI_BASE_URL=
ANTHROPIC_BASE_URL=

# (선택) AI 호출 튜닝 (기본값: 타임아웃 20초 / 최대 2048 토큰 / 온도 0.7)
AI_TIMEOUT_MS=
AI_MAX_TOKENS=
AI_TEMPERATURE=

# ============================================================================
# 7. [토스페이먼츠 실결제 연동] 결제 게이트웨이 설정
# ----------------------------------------------------------------------------
# - 클라이언트 키(브라우저 노출 O)와 시크릿 키(서버 전용, 절대 노출 금지)를 모두 주입하면
#   TOSS_LIVE 실결제 모드로 동작하고, 없으면 기존 샌드박스 시뮬레이션으로 폴백합니다.
# - PUBLIC_BASE_URL 은 결제 성공/실패 리다이렉트 URL 생성에 사용됩니다.
#   (로컬: http://localhost:3003 / 배포: https://실제-도메인)
# ============================================================================
TOSS_PAYMENTS_CLIENT_KEY=
TOSS_PAYMENTS_SECRET_KEY=
PUBLIC_BASE_URL=

# ============================================================================
# 8. [Supabase 영속화] 세션·주문·매출 원장 DB 영구 보관 설정
# ----------------------------------------------------------------------------
# - 두 값을 모두 주입하면 Supabase(PostgREST)로 원장이 영구 저장됩니다.
# - 없으면 인메모리 모드로 동작하며(서비스는 정상), 서버 재시작 시 데이터가 소실됩니다.
# - SUPABASE_PERSISTENCE: auto | on | off  (off 로 두면 강제로 인메모리 모드)
# - ⚠️ SERVICE_ROLE_KEY 는 RLS 를 우회하는 서버 전용 키입니다. 절대 클라이언트 노출 금지.
# - 적용 순서: supabase/migrations/006_create_runtime_persistence_tables.sql 실행 후 재시작
# ============================================================================
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PERSISTENCE=
SUPABASE_TIMEOUT_MS=

# ============================================================================
# 9. [토스페이먼츠 웹훅] 가상계좌 입금 확인 · 결제 상태 변경 · 빌링키 삭제 수신
# ----------------------------------------------------------------------------
# - 콘솔 > 개발자센터 > 웹훅에서 아래 URL 을 등록하세요.
#     {PUBLIC_BASE_URL}/api/webhooks/toss?token={TOSS_WEBHOOK_PATH_TOKEN}
# - 결제 웹훅에는 서명이 없으므로 본문 status 를 신뢰하지 않고
#   토스 API 재조회(canonical) 결과만 반영합니다(항상 ON, 실결제 모드).
# - PATH_TOKEN 은 무작위 스캐너 요청을 1차 차단하는 공유 비밀값입니다(권장).
# ============================================================================
TOSS_WEBHOOK_PATH_TOKEN=
TOSS_WEBHOOK_VERIFY_CANONICAL=
TOSS_WEBHOOK_TIMEOUT_MS=

# ============================================================================
# 10. [자동결제(빌링)] 카드 등록 → 정기 갱신 · 실패 재시도 · 해지
# ----------------------------------------------------------------------------
# - TOSS_BILLING_ENABLED=auto(기본): TOSS_LIVE 키가 있으면 자동 청구 활성
# - BILLING_SCHEDULER_ENABLED=auto(기본): 만기 구독을 주기적으로 자동 청구
#   ※ 운영 첫 배포 시에는 false 로 두고 수동 검증 후 켜는 것을 권장합니다.
# - 자동결제는 토스페이먼츠와 별도의 '자동결제' 계약이 필요합니다.
# ============================================================================
TOSS_BILLING_ENABLED=
BILLING_SCHEDULER_ENABLED=
BILLING_SCHEDULER_INTERVAL_MS=
BILLING_RETRY_MAX=
BILLING_RETRY_DELAY_HOURS=
BILLING_RENEWAL_PERIOD_DAYS=
TOSS_BILLING_ADMIN_TOKEN=

# ============================================================================
# 11. [App-in-Toss 인앱 결제(IAP)] SDK 지급 콜백 + 파트너 API 주문 검증
# ----------------------------------------------------------------------------
# - AIT_API_KEY 가 없으면 SANDBOX_SIMULATION(개발 전용 시뮬레이션 지급)으로 동작합니다.
# - 실결제 검증에는 파트너 API mTLS 클라이언트 인증서가 필요합니다(콘솔에서 발급).
# - SKU 는 앱인토스 콘솔에 등록한 상품 ID 와 1:1로 일치해야 합니다.
# ============================================================================
AIT_API_KEY=
AIT_API_BASE_URL=
AIT_APP_ID=
AIT_MTLS_CERT_PATH=
AIT_MTLS_KEY_PATH=
AIT_MTLS_CA_PATH=
AIT_MTLS_KEY_PASSPHRASE=
AIT_IAP_SKU_VIP_ANNUAL=
AIT_IAP_SKU_STARTER_PACK=
AIT_IAP_SKU_VIP_SUBSCRIPTION=
AIT_IAP_ADMIN_TOKEN=
AIT_SESSION_SECRET=
AIT_IAP_TIMEOUT_MS=
AIT_IAP_ALLOW_UNBOUND_GRANT=
# - AIT_IAP_SANDBOX_GRANT: 로컬 데모에서만 true (운영 기본 false)
AIT_IAP_SANDBOX_GRANT=

# ============================================================================
# 12. [AI 응답 캐싱] 동일 입력 재요청 시 LLM/Vision 재호출 방지
# ----------------------------------------------------------------------------
# - 캐시 키 = SHA-256(프롬프트 버전 + provider/model + 프롬프트 + 이미지 바이트)
# - 응답 본문은 AES-256-GCM 으로 암호화되어 메모리 LRU + Supabase(009)에 저장됩니다.
# - 원본 이미지·프롬프트는 저장하지 않고 해시만 남깁니다.
# ============================================================================
AI_CACHE_ENABLED=
AI_CACHE_VERSION=
AI_CACHE_TTL_MS=
AI_CACHE_SKIN_SCAN_TTL_MS=
AI_CACHE_REPORT_TTL_MS=
AI_CACHE_MAX_ENTRIES=
AI_CACHE_MAX_PAYLOAD_BYTES=
AI_CACHE_UNIT_COST_USD=
AI_CACHE_PERSIST=
