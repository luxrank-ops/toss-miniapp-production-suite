# ============================================================================
# [제2호 토스 미니앱: 환급레이더 AI] 사용자 동적 주입 환경변수 템플릿 (.env.example)
# ----------------------------------------------------------------------------
# 배포 직전 사용자(앱 소유자)가 아래 공란에 본인의 식별 정보와 판매 금액을 직접 기입합니다.
# ============================================================================

# 1. 앱 소유자(판매자) 개인 식별 정보
APP_OWNER_ID=
USER_IDENTITY=

# 2. 환급레이더 AI 프리미엄 리포트 잠금 해제 금액 (원 단위 숫자, 예: 2900)
MONETIZATION_PRICE=
REVENUE_PRICE=

# 3. 정산 계좌 정보 (AES-256 암호화 보관 대상)
OWNER_SETTLEMENT_ACCOUNT=

# 4. 고객 개인정보 보호용 AES-256-GCM 암호화 비밀키
ENCRYPTION_SECRET_KEY=

# 5. 서버 포트 번호 (1호 앱과 동시 실행 가능하도록 3001번 권장)
PORT=
